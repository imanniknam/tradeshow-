# SQLite database location. Relative paths are resolved from the project root.
# In Docker/production point this at a persistent volume, e.g. file:/app/data/app.db
DATABASE_URL="file:./prisma/dev.db"

# Hosted SQLite on Turso (e.g. for Vercel), instead of the file above:
# DATABASE_URL="libsql://<database>-<org>.turso.io"
# DATABASE_AUTH_TOKEN="<turso db tokens create ...>"
